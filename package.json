{
  "name": "ztoad-development",
  "private": true,
  "description": "Local quality tooling for the ZTOAD abapGit repository",
  "scripts": {
    "lint": "abaplint",
    "lint:quality": "node scripts/abaplint-quality.mjs",
    "test:installation": "node --test scripts/installation-contract.test.mjs && node scripts/installation-contract.mjs",
    "test:repository": "node scripts/repository-contract.mjs",
    "test": "npm run lint && npm run test:repository && npm run test:installation"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@abaplint/cli": "2.120.18"
  }
}
